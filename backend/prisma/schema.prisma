// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["rhel-openssl-3.0.x", "windows", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============== ENUMS ==============

enum UserType {
  individual
  company
}

enum UserRole {
  user
  admin
  curator
}

enum KycStatus {
  none
  pending
  verified
}

enum PhoneVerificationStatus {
  none
  pending
  verified
  rejected
}

enum ProductStatus {
  Pending
  In_Review
  Approved
  Rejected
  Sold
}

enum AuthenticityStatus {
  Pending
  Verified
  Rejected
  Under_Review
}

enum ListingCategory {
  normal
  featured
  most_rare
}

enum OrderStatus {
  Pending
  Processing
  Shipped
  Delivered
  Cancelled
}

enum PaymentStatus {
  Pending
  Paid
  Failed
  Refunded
}

enum PaymentMethod {
  online
  cod
  card
  upi
  bank_transfer
  whatsapp
}

enum OrderItemStatus {
  Pending
  Shipped
  Delivered
}

enum VendorType {
  SINGLE
  BULK
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AuctionStatus {
  UPCOMING
  ACTIVE
  SOLD
  ENDED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum CartAction {
  ADD
  REMOVE
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// NOTE (#18): Future migration - convert Product.category (String) → enum ProductCategory, Product.condition (String) → enum ProductCondition, ContactMessage.subject (String) → enum ContactSubject, GalleryItem.theme/origin/timePeriod (String) → respective enums
// NOTE (#39): Future migration - standardize enum case to PascalCase: UserType (individual→Individual, company→Company), UserRole (user→User, admin→Admin, curator→Curator), KycStatus, PhoneVerificationStatus, ListingCategory

// ============== MODELS ==============

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password   String?
  supabaseId String?  @unique
  phone      String?  @unique
  phoneVerificationStatus PhoneVerificationStatus @default(none)
  type      UserType @default(individual)
  role      UserRole @default(user)
  kycStatus KycStatus @default(none)
  kycData   Json?    @default("{}")
  banned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  cart      CartItem[]
  wishlist  WishlistItem[]
  orders    Order[]
  vendor    Vendor?
  notifications    Notification[]
  bids             AuctionBid[]
  pushSubscriptions PushSubscription[]
  testimonials     Testimonial[]
  productViews     ProductView[]
  cartEvents       CartEvent[]
  checkoutEvents   CheckoutEvent[]
  auditLogs        AuditLog[]
  ratings          Rating[]
  reviews          Review[]
  galleryItems     GalleryItem[]
  createdCoupons   Coupon[]
  couponUsages     CouponUsage[]

  @@index([kycStatus])
  @@index([role])
}

model Product {
  id                 String           @id @default(cuid())
  title              String
  category           String
  brand              String?
  listingCategory    ListingCategory  @default(normal)
  description        String
  condition          String
  price              Float
  quantity           Int              @default(1)
  image              String
  images             String[]
  keywords           String[]
  isVerified         Boolean          @default(false)
  authenticityStatus AuthenticityStatus @default(Pending)
  commissionPercent  Float            @default(10)
  specs              Json             @default("[]")
  // Competitor listings for the same/similar item elsewhere, e.g.
  // [{"platformId": "...", "url": "...", "price": 12000}]. Keyed by
  // ComparisonPlatform.id; set by the seller (optional) or overwritten by an
  // admin. Not a relation for the same reason `specs` isn't — a small,
  // per-product array that never needs its own table or joins.
  comparisons        Json             @default("[]")

  // Admin-only free-text values for admin-defined custom columns, keyed by
  // column id: {"col_abc123": "paid in cash"}. NEVER expose publicly —
  // it is globally omitted in plugins/prisma.js and only re-enabled on
  // admin-authenticated routes.
  adminNotes         Json             @default("{}")

  status             ProductStatus    @default(Pending)
  isPublished        Boolean          @default(false)
  rejectionReason    String?
  reviewedAt         DateTime?
  reviewedBy         String?

  sellerId           String
  seller             User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  reviews        Review[]
  auction        Auction?
  productViews   ProductView[]
  cartEvents     CartEvent[]
  checkoutEvents CheckoutEvent[]
  coupons        Coupon[]

  @@index([sellerId])
  @@index([category])
  @@index([isPublished])
  @@index([status])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String
  teaser       String
  description  String
  images       String[]
  origin       String
  timePeriod   String
  institution  String
  significance String
  theme        String
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([theme])
  @@index([createdAt])
}

model Blog {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  excerpt         String
  content         String
  coverImage      String?
  author          String
  authorId        String?
  authorAvatar    String?
  category        String
  tags            String[]
  status          BlogStatus  @default(DRAFT)
  featured        Boolean     @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  readingTime     Int?
  viewCount       Int           @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
  @@index([category])
  @@index([featured])
}

model Coupon {
  id              String        @id @default(cuid())
  code            String        @unique
  description     String?
  discountPercent Float         @default(10)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  minPurchase     Float         @default(0)
  maxUses         Int           @default(0)
  maxUsesPerUser  Int           @default(0)
  isActive        Boolean       @default(true)
  expiresAt       DateTime?
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  usages          CouponUsage[]
  orders          Order[]

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt    DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([userId])
}

model Order {
  id              String        @id @default(cuid())
  displayId       String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  buyerName       String?
  buyerPhone      String?
  status          OrderStatus   @default(Pending)
  totalAmount     Float
  shippingAddress String
  city            String
  state           String
  zipCode         String
  phone           String
  trackingID      String?

  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountPercent Float         @default(0)
  discountAmount  Float         @default(0)
  subtotalBeforeDiscount Float  @default(0)

  paymentStatus   PaymentStatus @default(Pending)
  paymentMethod   PaymentMethod @default(online)
  paymentId       String?       @unique
  paymentOrderId  String?
  paymentSignature String?

  isManual        Boolean       @default(false)

  items           OrderItem[]
  couponUsages    CouponUsage[]
  reviews         Review[]
  outboundMessages OutboundMessage[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([displayId])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  quantity          Int            @default(1)
  price             Float
  commissionPercent Float          @default(10)
  platformFee       Float          @default(0)
  status            OrderItemStatus @default(Pending)
  trackingID        String?
  paidOut           Boolean        @default(false)
  payoutId          String?
  createdAt         DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([paidOut])
}

model Vendor {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         VendorType    @default(SINGLE)
  status       VendorStatus  @default(PENDING)
  maxListings  Int           @default(5)
  companyName  String?
  gst          String?
  founderName  String?
  aadhaar      String?
  pan          String?

  aadhaarDoc       String?
  panDoc           String?
  gstDoc           String?
  incorporationDoc String?

  agreementAccepted   Boolean   @default(false)
  agreementSignedAt   DateTime?
  agreementSignedByName String?
  signedAgreementDoc  String?

  pickupAddress     String?
  pickupCity        String?
  pickupState       String?
  pickupZip         String?
  pickupContactName String?
  pickupPhone       String?
  pickupVerified    Boolean  @default(false)
  pickupVerifiedAt  DateTime?
  pickupVerifiedBy  String?

  // Where the seller's payout actually goes. Deliberately UPI-only: a UPI ID is
  // far less sensitive than an account number + IFSC, so it keeps this out of
  // "financial PII needing encryption at rest" territory while still covering
  // most Indian sellers. Before this existed, sellers saw PENDING payouts for
  // money that had no destination on file at all.
  payoutUpi          String?
  payoutUpiName      String?
  payoutUpiUpdatedAt DateTime?

  rating       Float    @default(0)
  ratingCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payouts       Payout[]
  ratings       Rating[]
  reviews       Review[]

  @@index([status])
  @@index([type])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action      String
  targetType  String
  targetId    String
  details     String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
}

model Auction {
  id             String        @id @default(cuid())
  title          String
  description    String
  images         String[]
  startingBid    Float
  currentBid     Float?
  reservePrice   Float?
  startDate      DateTime
  endDate        DateTime
  status         AuctionStatus @default(UPCOMING)
  productId      String?       @unique
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  bids           AuctionBid[]

  @@index([status])
  @@index([endDate])
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  createdAt DateTime @default(now())

  @@index([auctionId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Testimonial {
  id         String           @id @default(cuid())
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  content    String
  rating     Int              @default(5)
  images     String[]         @default([])
  status     TestimonialStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status])
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

model CartEvent {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    CartAction
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([productId])
}

model ContactMessage {
  id         String    @id @default(cuid())
  name       String
  email      String
  subject    String
  message    String
  read       Boolean   @default(false)
  status     String    @default("UNREAD")
  replyText  String?
  repliedAt  DateTime?
  repliedBy  String?
  createdAt  DateTime  @default(now())

  @@index([read])
  @@index([status])
  @@index([createdAt])
}

model CheckoutEvent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@unique([userId, endpoint])
}

model Payout {
  id          String       @id @default(cuid())
  vendorId    String
  vendor      Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amount      Float
  status      PayoutStatus @default(PENDING)
  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([vendorId])
  @@index([status])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  vendorId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rating    Int
  createdAt DateTime @default(now())

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, orderId, productId])
  @@index([vendorId])
  @@index([productId])
  @@index([orderId])
}

model QrCode {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  targetUrl String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scans     QrScan[]
}

model QrScan {
  id          String   @id @default(cuid())
  qrCodeId    String
  qrCode      QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  scannedAt   DateTime @default(now())
  visitorId   String?
  deviceHash  String?
  ipHash      String?
  country     String?
  countryCode String?
  region      String?
  city        String?
  latitude    Float?
  longitude   Float?
  deviceType  String?
  os          String?
  browser     String?

  @@index([qrCodeId, scannedAt])
  @@index([country])
  @@index([city])
  @@index([deviceType])
  @@index([os])
}

// Admin-managed list of third-party marketplaces (eBay, Chrono24, ...) a
// product's listing can be compared against. Not a hardcoded set — admin adds
// more from the dashboard. Deliberately no relation to Product: a product's
// actual comparison entries live in Product.comparisons (Json, keyed by this
// model's id), so deleting a platform here just makes old references to it
// stop rendering rather than requiring a cascading cleanup.
model ComparisonPlatform {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin outbox — drafted customer messages the operator sends by hand.
//
// There is no transactional email provider wired into this project, and that is
// a deliberate choice: adding one costs money and would send customer name,
// address and email to a third-party processor. Instead, order events draft a
// message here and the admin dashboard renders it with copy-to-clipboard, so
// the operator sends it from their own mail client. No customer data leaves our
// infrastructure, and the buyer still gets a receipt.
//
// If a provider is ever adopted, this table becomes the send queue rather than
// being thrown away — status/sentAt/sentBy already model that.
// ─────────────────────────────────────────────────────────────────────────────

enum OutboundMessageType {
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
}

enum OutboundMessageStatus {
  PENDING
  SENT
  SKIPPED
}

model OutboundMessage {
  id     String                @id @default(cuid())
  type   OutboundMessageType
  status OutboundMessageStatus @default(PENDING)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Snapshotted at draft time, not joined at read time: the message must still
  // render exactly as drafted even if the user later edits their profile.
  recipientEmail String
  recipientName  String?

  subject  String
  bodyText String  @db.Text
  bodyHtml String? @db.Text

  sentAt DateTime?
  sentBy String?
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([orderId])
  @@index([createdAt])
}
